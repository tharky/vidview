{
  "version": 6,
  "configurePresets": [
    {
      "name": "ucrt64-debug",
      "displayName": "UCRT64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}",
        "PKG_CONFIG_PATH": "C:/msys64/ucrt64/lib/pkgconfig"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ucrt64-debug",
      "configurePreset": "ucrt64-debug"
    }
  ]
}